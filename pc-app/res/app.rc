      VALUE "FileDescription", "R6 Replay Uploader"
      VALUE "ProductName", "R6 Replay Uploader"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "R6ReplayUploader"
      VALUE "OriginalFilename", "R6ReplayUploader.exe"
    END
